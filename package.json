    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  }
